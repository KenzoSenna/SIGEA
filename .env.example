# Configuração de conexão MySQL local
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=db_nome
DB_DRIVER=pymysql
DB_ECHO=False

# Seguranca
# Gere uma chave forte, ex.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS: origens permitidas separadas por virgula (use o dominio do front em producao)
CORS_ORIGINS=*
